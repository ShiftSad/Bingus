# Borda pública, no VPS. O dedicado só escuta na WireGuard: API em 10.10.0.2:2026 e
# frontend em 10.10.0.2:2027 (BINGUS_API_BIND e BINGUS_WEB_BIND na .env do dedicado).
api.shiftsad.dev {
    encode gzip
    reverse_proxy 10.10.0.2:2026

    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
}

bingus.shiftsad.dev {
    encode gzip
    reverse_proxy 10.10.0.2:2027

    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
