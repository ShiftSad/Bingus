          "rawSql": "SELECT $__timeGroupAlias(s.at, $__interval, 0), e.key AS metric, sum(e.value::int) * 60000.0 / $__interval_ms AS value\nFROM worker_samples s, jsonb_each_text(s.errors) e\nWHERE $__timeFilter(s.at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "5m"
