      "id": 2,
      "type": "stat",
      "title": "Páginas",
      "datasource": {
        "type": "grafana-postgres-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgres-datasource",
            "uid": "${DS}"
          },
          "rawQuery": true,
          "rawSql": "SELECT pages AS value FROM api_samples ORDER BY at DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
